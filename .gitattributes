* text=auto

*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf
*.ps1     text eol=crlf
*.md      text
*.json    text
*.py      text eol=lf

# Unity (YAML serializado)
*.unity    text eol=lf merge=unityyamlmerge
*.prefab   text eol=lf merge=unityyamlmerge
*.asset    text eol=lf merge=unityyamlmerge
*.meta     text eol=lf
*.mat      text eol=lf
*.anim     text eol=lf
*.controller text eol=lf

# Binários
*.blend  binary
*.fbx    binary
*.png    binary
*.jpg    binary
*.psd    binary
*.dll    binary
